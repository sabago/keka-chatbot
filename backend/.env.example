# ============================================================================
# KEKA CHATBOT - ENVIRONMENT CONFIGURATION
# ============================================================================

# ----------------------------------------------------------------------------
# Server Configuration
# ----------------------------------------------------------------------------
PORT=3001
# NODE_ENV Options: 'development' | 'production'
# - development: Emails logged to console only (no AWS calls, no credentials needed)
# - production: Real emails sent via AWS SES (requires AWS credentials)
NODE_ENV=development

# Server time zone. Weekly report day/hour use the server clock (UTC on
# Railway); set this so times are Massachusetts time (EST/EDT handled)
TZ=America/New_York

# ----------------------------------------------------------------------------
# Security & Embedding Configuration
# ----------------------------------------------------------------------------
# Comma-separated list of domains allowed to embed the chatbot in an iframe
# Used in Content-Security-Policy frame-ancestors directive
# Note: Do NOT include https:// - just the domain name
# Example: yoursite.com,www.yoursite.com
ALLOWED_EMBED_DOMAINS=kekarehabservices.com,www.kekarehabservices.com

# ----------------------------------------------------------------------------
# AWS Credentials (REQUIRED FOR PRODUCTION ONLY)
# ----------------------------------------------------------------------------
# For development (NODE_ENV=development): Leave as placeholders - AWS not used
# For production (NODE_ENV=production): Replace with real AWS IAM credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# ----------------------------------------------------------------------------
# Email Notification Settings (Admin Notifications Only)
# ----------------------------------------------------------------------------
# IMPORTANT: All notifications are sent to ADMIN TEAM ONLY
# Users who submit forms do NOT receive confirmation emails
#
# SES_FROM_EMAIL: Sender address (must be verified in AWS SES)
# ADMIN_EMAIL: REQUIRED - the To: recipient for every notification
# HANDOFF_EMAIL: Optional comma-separated list of Bcc recipients (e.g. addr1@example.com,addr2@example.com)
# Recipients must be covered by a HIPAA BAA (notifications include contact details)
SES_FROM_EMAIL=noreply@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com
HANDOFF_EMAIL=second@yourdomain.com,third@yourdomain.com

# ============================================================================
# PRODUCTION SETUP INSTRUCTIONS
# ============================================================================
#
# Step 1: Set up AWS SES (Email Service)
# ----------------------------------------
# 1. Go to AWS SES Console: https://console.aws.amazon.com/ses/
# 2. Click "Verified identities" → "Create identity"
# 3. Verify your sender email (SES_FROM_EMAIL above)
# 4. In SES Sandbox mode (default), you must also verify each address in:
#    - ADMIN_EMAIL
#    - HANDOFF_EMAIL (all comma-separated recipients)
# 5. For unrestricted sending, request "Production Access" in SES console
#    (Go to "Account dashboard" → "Request production access")
#
# Step 2: Create IAM User with Required Permissions
# --------------------------------------------------
# 1. Go to AWS IAM Console: https://console.aws.amazon.com/iam/
# 2. Create a new user (e.g., "keka-chatbot-notifications")
# 3. Attach these policies:
#    - AmazonSESFullAccess (for email)
# 4. Generate access keys:
#    - Go to user → "Security credentials" → "Create access key"
#    - Choose "Application running outside AWS"
#    - Copy AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY to this file
#
# Step 3: Switch to Production Mode
# ----------------------------------
# 1. Update NODE_ENV to 'production'
# 2. Update the AWS credentials above
# 3. Restart the server
# 4. Test with a form submission - check the admin email
#
# ============================================================================
# DEVELOPMENT MODE BEHAVIOR
# ============================================================================
#
# When NODE_ENV=development (current setting):
# - NO AWS credentials needed
# - NO emails actually sent
# - Notifications printed to console in formatted boxes
# - Perfect for local testing without AWS account
#
# Console output will show:
# ┌─────────────────────────────────────────────────┐
# │ EMAIL NOTIFICATION (DEVELOPMENT MODE)          │
# │ From: noreply@yourdomain.com                   │
# │ To: admin@yourdomain.com                       │
# │ Subject: New Patient / Client Intake Request   │
# │ [Full email content displayed]                 │
# └─────────────────────────────────────────────────┘
#
# ============================================================================
